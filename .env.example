# API Key for external scraper (generate a secure random string)
SCRAPER_API_KEY="your-secure-api-key-here"

# Admin API Key for spot verification
ADMIN_API_KEY="your-admin-api-key-here"

NEXT_PUBLIC_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY

# Python scraper settings (optional - can also use environment variables)
# API_BASE_URL="http://localhost:3000"

# Firebase (for Google Sign-In) - from Firebase Console > Project settings > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
